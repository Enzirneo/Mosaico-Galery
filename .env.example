# Copie para .env.local (ignorado pelo git) e preencha o que precisar.
# Variáveis de ambiente por modo:
#   .env.development        -> npm run dev  (Supabase LOCAL, já versionado)
#   variáveis da hospedagem -> produção     (veja .env.production.example)

# Chave do Pexels, SÓ para desenvolvimento. Nunca entra no build de produção
# (lá o Pexels é chamado pela Edge Function "pexels", com a chave no servidor).
VITE_PEXELS_API_KEY=
