# Supabase (Project Settings > API). Sem isto o app roda em "modo local" (dados no navegador).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Somente para desenvolvimento local SEM Supabase. Em produção a chave do Pexels
# fica como secret da Edge Function "pexels" e nunca vai para o navegador.
VITE_PEXELS_API_KEY=
